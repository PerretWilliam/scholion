{
  "name": "scholion",
  "private": true,
  "description": "Offline documentation assistant powered by a local language model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerretWilliam/scholion.git"
  },
  "bugs": "https://github.com/PerretWilliam/scholion/issues",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:llama": "node scripts/fetch-llama.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm lint:rust && pnpm test:rust"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@assistant-ui/react": "^0.15.29",
    "@assistant-ui/react-ai-sdk": "^1.4.18",
    "@streamdown/code": "^2.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.141",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "shadcn": "^4.21.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.4"
  }
}
