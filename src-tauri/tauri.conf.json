{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scholion",
  "version": "0.1.0",
  "identifier": "com.williamperret.scholion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scholion",
        "width": 1000,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://openrouter.ai https://api.openai.com",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Offline documentation assistant powered by a local language model",
    "copyright": "Copyright © 2026 William Perret",
    "license": "MIT",
    "resources": {
      "resources/llama/": "llama/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libssl3",
          "libvulkan1"
        ]
      },
      "rpm": {
        "depends": [
          "openssl-libs",
          "vulkan-loader"
        ]
      }
    }
  }
}
